{
  "name": "aria-player",
  "productName": "Aria Player",
  "version": "0.2.3",
  "description": "咏叹调 — 网易云音乐/QQ音乐 解析播放下载桌面工具",
  "main": "./dist/out/main/index.js",
  "author": "NTR",
  "license": "MIT",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor-server.mjs",
    "vendor:qq": "node scripts/vendor-qqmusic.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build-app.mjs",
    "start": "electron-vite preview",
    "smoke": "node scripts/smoke-server.mjs",
    "test:tags": "node scripts/gen-tag-samples.js && node src/main/tags/writeTags.test.mjs",
    "pack:win": "node scripts/build-app.mjs && electron-builder --win",
    "pack:mac": "node scripts/build-app.mjs && electron-builder --mac",
    "pack:dir": "node scripts/build-app.mjs && electron-builder --dir"
  },
  "dependencies": {
    "hls.js": "^1.7.0",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pinia": "^3.0.4",
    "vite": "^7.3.6",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  }
}

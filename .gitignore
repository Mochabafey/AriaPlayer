resources/ffmpeg/

# 临时与日志
*.log
.npm-fresh-cache/
.DS_Store

# 标签测试生成的样本（由 scripts/gen-tag-samples.js 生成）
scripts/samples/

# IDE
.vscode/
.idea/

# 代码索引/分析产物
server/.codegraph/

